{
  "name": "@attricat/extension",
  "version": "0.1.0",
  "description": "Write Attricat native UI contributions with Preact: runtime, hooks, Vite preset, packer and test harness.",
  "type": "module",
  "files": [
    "dist",
    "src",
    "bin",
    "README.md"
  ],
  "bin": {
    "attricat-pack": "./bin/attricat-pack.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./pack": {
      "source": "./src/pack.ts",
      "types": "./dist/pack.d.ts",
      "default": "./dist/pack.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@attricat/ui-kit": "workspace:*",
    "@quilted/threads": "4.1.0",
    "@remote-dom/core": "1.12.1",
    "@remote-dom/preact": "1.3.1"
  },
  "devDependencies": {
    "preact": "10.29.8",
    "vite": "7.3.7"
  },
  "peerDependencies": {
    "preact": "^10.24.0",
    "vite": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
