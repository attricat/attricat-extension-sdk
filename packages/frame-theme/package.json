{
  "name": "@attricat/frame-theme",
  "version": "0.1.0",
  "description": "Attricat's design tokens, MUI theme and color-mode helpers for Frame UI contributions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "tokens",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./mui": {
      "source": "./src/mui.ts",
      "types": "./dist/src/mui.d.ts",
      "default": "./dist/src/mui.js"
    },
    "./tokens/*.json": "./tokens/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "6.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "@mui/material": "^6.4.0"
  },
  "peerDependenciesMeta": {
    "@mui/material": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
